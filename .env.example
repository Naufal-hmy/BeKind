# Kredensial Supabase untuk GabutFaedah
# Salin file ini menjadi ".env" lalu isi dengan kredensial dari dashboard Supabase Anda.
# Jika kosong, aplikasi akan otomatis masuk ke "Demo Mode" menggunakan penyimpanan lokal (AsyncStorage).

EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
